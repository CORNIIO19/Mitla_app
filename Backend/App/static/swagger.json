{
  "openapi": "3.0.0",

  "info": {
    "title": "Gestor Inteligente de Notas API",
    "version": "1.0.0",
    "description": "API para gestionar usuarios y notas"
  },

  "servers": [
    {
      "url": "http://127.0.0.1:5000"
    }
  ],

  "paths": {

    "/": {

      "get": {

        "summary": "Verificar estado del backend",

        "responses": {

          "200": {
            "description": "Servidor funcionando"
          }

        }

      }

    },

    "/api/auth/register": {

      "post": {

        "summary": "Registrar usuario",

        "requestBody": {

          "required": true,

          "content": {

            "application/json": {

              "schema": {

                "type": "object",

                "properties": {

                  "nombre": {
                    "type": "string",
                    "example": "Omar"
                  },

                  "email": {
                    "type": "string",
                    "example": "omar@test.com"
                  },

                  "telefono": {
                    "type": "string",
                    "example": "5555555555"
                  },

                  "password": {
                    "type": "string",
                    "example": "123456"
                  }

                }

              }

            }

          }

        },

        "responses": {

          "201": {
            "description": "Usuario registrado correctamente"
          },

          "409": {
            "description": "El email ya existe"
          }

        }

      }

    },

    "/api/auth/login": {

      "post": {

        "summary": "Iniciar sesión",

        "requestBody": {

          "required": true,

          "content": {

            "application/json": {

              "schema": {

                "type": "object",

                "properties": {

                  "email": {
                    "type": "string",
                    "example": "omar@test.com"
                  },

                  "password": {
                    "type": "string",
                    "example": "123456"
                  }

                }

              }

            }

          }

        },

        "responses": {

          "200": {
            "description": "Login correcto"
          },

          "401": {
            "description": "Credenciales inválidas"
          }

        }

      }

    },

    "/api/notas/": {

      "get": {

        "summary": "Obtener notas del usuario",

        "security": [
          {
            "bearerAuth": []
          }
        ],

        "responses": {

          "200": {
            "description": "Lista de notas"
          }

        }

      },

      "post": {

        "summary": "Crear nota",

        "security": [
          {
            "bearerAuth": []
          }
        ],

        "requestBody": {

          "required": true,

          "content": {

            "application/json": {

              "schema": {

                "type": "object",

                "properties": {

                  "titulo": {
                    "type": "string",
                    "example": "Mi primera nota"
                  },

                  "contenido": {
                    "type": "string",
                    "example": "# Hola\nContenido markdown"
                  },

                  "visibilidad": {
                    "type": "string",
                    "example": "privada"
                  }

                }

              }

            }

          }

        },

        "responses": {

          "201": {
            "description": "Nota creada"
          }

        }

      }

    }

  },

  "components": {

    "securitySchemes": {

      "bearerAuth": {

        "type": "http",

        "scheme": "bearer",

        "bearerFormat": "JWT"

      }

    }

  }

}
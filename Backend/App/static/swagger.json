{
  "openapi": "3.0.0",
  "info": {
    "title": "Gestor Inteligente de Notas API",
    "version": "1.0.0",
    "description": "API para autenticación, gestión de bases de conocimiento y administración de archivos mediante Strategy."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5000"
    }
  ],
  "tags": [
    {
      "name": "Autenticación"
    },
    {
      "name": "Bases de conocimiento"
    },
    {
      "name": "Archivos"
    },
    {
      "name": "Chat"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Verificar estado de la API",
        "tags": [
          "Sistema"
        ],
        "responses": {
          "200": {
            "description": "API funcionando correctamente"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Registrar usuario",
        "tags": [
          "Autenticación"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistroUsuario"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario registrado correctamente"
          },
          "400": {
            "description": "Datos obligatorios faltantes"
          },
          "409": {
            "description": "El email ya está registrado"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Iniciar sesión",
        "tags": [
          "Autenticación"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginUsuario"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login correcto. Devuelve token JWT."
          },
          "401": {
            "description": "Credenciales inválidas"
          }
        }
      }
    },
    "/api/bases/": {
      "get": {
        "summary": "Listar bases de conocimiento del usuario",
        "tags": [
          "Bases de conocimiento"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de bases de conocimiento"
          },
          "401": {
            "description": "Token inválido o ausente"
          }
        }
      },
      "post": {
        "summary": "Crear base de conocimiento",
        "tags": [
          "Bases de conocimiento"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BaseConocimientoCrear"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Base de conocimiento creada correctamente"
          },
          "400": {
            "description": "El nombre es obligatorio"
          },
          "401": {
            "description": "Token inválido o ausente"
          }
        }
      }
    },
    "/api/bases/{id_base}": {
      "get": {
        "summary": "Obtener una base de conocimiento por ID",
        "tags": [
          "Bases de conocimiento"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdBase"
          }
        ],
        "responses": {
          "200": {
            "description": "Base encontrada"
          },
          "404": {
            "description": "Base no encontrada"
          }
        }
      },
      "put": {
        "summary": "Actualizar base de conocimiento",
        "tags": [
          "Bases de conocimiento"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdBase"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BaseConocimientoCrear"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Base actualizada correctamente"
          },
          "404": {
            "description": "Base no encontrada"
          }
        }
      },
      "delete": {
        "summary": "Eliminar base de conocimiento",
        "tags": [
          "Bases de conocimiento"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdBase"
          }
        ],
        "responses": {
          "200": {
            "description": "Base eliminada correctamente"
          },
          "404": {
            "description": "Base no encontrada"
          }
        }
      }
    },
    "/api/archivos/base/{id_base}/subir": {
      "post": {
        "summary": "Subir archivo a una base de conocimiento",
        "description": "Permite subir archivos soportados por el patrón Strategy. Actualmente soporta .md y .txt.",
        "tags": [
          "Archivos"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdBase"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "archivo"
                ],
                "properties": {
                  "archivo": {
                    "type": "string",
                    "format": "binary",
                    "description": "Archivo .md o .txt"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Archivo guardado correctamente"
          },
          "400": {
            "description": "Archivo no enviado, inválido o tipo no soportado"
          },
          "401": {
            "description": "Token inválido o ausente"
          }
        }
      }
    },
    "/api/archivos/base/{id_base}": {
      "get": {
        "summary": "Listar archivos de una base de conocimiento",
        "tags": [
          "Archivos"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdBase"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de archivos registrados en la base"
          },
          "401": {
            "description": "Token inválido o ausente"
          }
        }
      }
    },
    "/api/archivos/{id_archivo}": {
      "get": {
        "summary": "Obtener archivo por ID",
        "tags": [
          "Archivos"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdArchivo"
          }
        ],
        "responses": {
          "200": {
            "description": "Archivo encontrado"
          },
          "404": {
            "description": "Archivo no encontrado"
          }
        }
      },
      "delete": {
        "summary": "Eliminar archivo",
        "tags": [
          "Archivos"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdArchivo"
          }
        ],
        "responses": {
          "200": {
            "description": "Archivo eliminado correctamente"
          },
          "404": {
            "description": "Archivo no encontrado"
          }
        }
      }
    },
    "/api/chat/preguntar": {
  "post": {
    "tags": [
      "Chat"
    ],
    "summary": "Realizar una pregunta sobre una base de conocimiento",
    "description": "Endpoint protegido que valida que la base pertenezca al usuario autenticado. En esta versión devuelve una respuesta simulada y no utiliza todavía RAG ni modelos de lenguaje.",
    "security": [
      {
        "bearerAuth": []
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/PreguntaChat"
          },
          "examples": {
            "preguntaProyecto": {
              "summary": "Pregunta sobre Proyecto Terminal",
              "value": {
                "id_base": 4,
                "pregunta": "¿Cuáles son los objetivos del proyecto?"
              }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Pregunta recibida y procesada correctamente",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/RespuestaChat"
            },
            "examples": {
              "respuestaSimulada": {
                "value": {
                  "respuesta": "Recibí tu pregunta y se consultará la base de conocimiento Proyecto Terminal.",
                  "id_base": 4,
                  "nombre_base": "Proyecto Terminal",
                  "fuentes": [],
                  "modo": "simulado"
                }
              }
            }
          }
        }
      },
      "400": {
        "description": "Petición inválida",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "preguntaVacia": {
                "value": {
                  "error": "La pregunta no puede estar vacía."
                }
              },
              "idInvalido": {
                "value": {
                  "error": "El campo id_base debe ser un entero válido."
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "JWT ausente, inválido o expirado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "404": {
        "description": "La base no existe o no pertenece al usuario",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "La base de conocimiento no fue encontrada."
            }
          }
        }
      },
      "500": {
        "description": "Error inesperado del servidor",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Ocurrió un error interno al procesar la solicitud."
            }
          }
        }
      }
    }
  }
}
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "IdBase": {
        "name": "id_base",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "example": 1
        }
      },
      "IdArchivo": {
        "name": "id_archivo",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "example": 1
        }
      }
    },
    "schemas": {
      "RegistroUsuario": {
        "type": "object",
        "required": [
          "nombre",
          "email",
          "password"
        ],
        "properties": {
          "nombre": {
            "type": "string",
            "example": "Omar"
          },
          "email": {
            "type": "string",
            "example": "omar@test.com"
          },
          "telefono": {
            "type": "string",
            "example": "5555555555"
          },
          "password": {
            "type": "string",
            "example": "123456"
          }
        }
      },
      "LoginUsuario": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "example": "omar@test.com"
          },
          "password": {
            "type": "string",
            "example": "123456"
          }
        }
      },
      "BaseConocimientoCrear": {
        "type": "object",
        "required": [
          "nombre"
        ],
        "properties": {
          "nombre": {
            "type": "string",
            "example": "Inteligencia Artificial"
          },
          "descripcion": {
            "type": "string",
            "example": "Base de conocimiento con archivos sobre IA, embeddings y RAG."
          }
        }
      },
      "PreguntaChat": {
  "type": "object",
  "required": [
    "id_base",
    "pregunta"
  ],
  "properties": {
    "id_base": {
      "type": "integer",
      "minimum": 1,
      "example": 4
    },
    "pregunta": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "example": "¿Cuáles son los objetivos del proyecto?"
    }
  }
},
"RespuestaChat": {
  "type": "object",
  "required": [
    "respuesta",
    "id_base",
    "nombre_base",
    "fuentes",
    "modo"
  ],
  "properties": {
    "respuesta": {
      "type": "string",
      "example": "Recibí tu pregunta y se consultará la base de conocimiento Proyecto Terminal."
    },
    "id_base": {
      "type": "integer",
      "example": 4
    },
    "nombre_base": {
      "type": "string",
      "example": "Proyecto Terminal"
    },
    "fuentes": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "example": []
    },
    "modo": {
      "type": "string",
      "enum": [
        "simulado",
        "rag"
      ],
      "example": "simulado"
    }
  }
},
"Error": {
  "type": "object",
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "string",
      "example": "La solicitud no pudo ser procesada."
    }
  }
  }
    }
  }
}